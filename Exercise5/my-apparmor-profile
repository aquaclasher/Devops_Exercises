#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  #include <abstractions/python>

  # App can run its Flask server
  /app/** rwk,
  /tmp/** rw,
  /dev/null rw,
  /dev/urandom r,

  # Python runtime + shared libraries (must be mmap-able)
  /usr/local/bin/python* rix,
  /usr/local/lib/** rm,
  /usr/local/lib/python*/** r,
  /usr/lib/** rm,
  /lib/** rm,
  /lib/x86_64-linux-gnu/** rm,
  /usr/lib/x86_64-linux-gnu/** rm,
  /usr/lib/python*/** r,

  # System files needed by Python and the app
  /etc/ld.so.cache r,
  /etc/ld.so.preload r,
  /etc/hosts r,
  /etc/nsswitch.conf r,
  /etc/resolv.conf r,
  /etc/localtime r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,

  # Required for DNS / networking
  /proc/** r,
  /sys/** r,

  # Network + port binding
  network inet stream,
  network inet dgram,
  capability net_bind_service,

  # Sensitive files to deny specifically
  deny /etc/passwd r,
  deny /etc/shadow r,
  deny /etc/group r,
  deny /etc/sudoers r,
  deny /etc/profile r,
  deny /root/.profile r,
  deny /var/** rw,

  # Deny shells
  deny /bin/bash x,
  deny /usr/bin/bash x,
  deny /bin/sh x,
  deny /usr/bin/sh x,
  deny /bin/dash x,
  deny /usr/bin/dash x,

  deny capability sys_admin,
}
